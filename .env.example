# Copy to .env.local (gitignored). Server-only unless prefixed NEXT_PUBLIC_.

# AI assistant (chat + embeddings)
GEMINI_API_KEY=
# Optional: override the chat model (default gemini-3.5-flash)
GEMINI_MODEL=

# Lead emails (Resend). Visitor emails come from LEAD_FROM_EMAIL on a domain verified in Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Supabase (project on the hamzabuildsweb account)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Random secret; its SHA-256 is stored in private.app_config ('server_secret_sha256').
SUPABASE_SERVER_SECRET=

# Free SEO audit tool: Google PageSpeed Insights API key (optional; without it the shared quota is often busy)
PAGESPEED_API_KEY=

# Content autopilot only (docs/AUTOPILOT.md): Search Console service account JSON (raw or base64) and property
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:hamzatariq.site

# Vercel Cron: random secret; Vercel sends it as "Authorization: Bearer <secret>" to /api/cron/publish
# and /api/outreach/discover. The same value is the CRON_SECRET GitHub repository secret used by
# .github/workflows/outreach-tick.yml for /api/outreach/tick.
CRON_SECRET=

# Outreach (/admin/prospects): Gmail account with an app password. Outreach emails are sent ONLY
# through this mailbox (never Resend or hamzatariq.site); IMAP reads replies and bounces.
OUTREACH_SMTP_HOST=smtp.gmail.com
OUTREACH_SMTP_PORT=465
OUTREACH_IMAP_HOST=imap.gmail.com
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASS=
OUTREACH_FROM=
# Postal address for the outreach footer. Empty = US businesses are never emailed (CAN-SPAM).
OUTREACH_POSTAL_ADDRESS=


