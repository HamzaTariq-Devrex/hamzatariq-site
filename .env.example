# Copy to .env.local (gitignored). Server-only unless prefixed NEXT_PUBLIC_.

# AI assistant (chat + embeddings)
GEMINI_API_KEY=
# Optional: override the chat model (default gemini-3.5-flash)
GEMINI_MODEL=

# Lead emails (Resend). Visitor emails come from LEAD_FROM_EMAIL on a domain verified in Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Booking: Calendly scheduling link (e.g. https://calendly.com/<name>/free-call). Empty = buttons go to /contact.
CALENDLY_URL=

# Supabase (project on the hamzabuildsweb account)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Random secret; its SHA-256 is stored in private.app_config ('server_secret_sha256').
SUPABASE_SERVER_SECRET=

# Free SEO audit tool: Google PageSpeed Insights API key (optional; without it the shared quota is often busy)
PAGESPEED_API_KEY=

# Content autopilot only (docs/AUTOPILOT.md): Search Console service account JSON (raw or base64) and property
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:hamzatariq.site
