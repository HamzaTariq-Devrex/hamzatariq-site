# Copy to .env.local (gitignored). Server-only unless prefixed NEXT_PUBLIC_.

# AI assistant (chat + embeddings)
GEMINI_API_KEY=
# Optional: override the chat model (default gemini-3.5-flash)
GEMINI_MODEL=

# Lead emails (Resend). Visitor emails come from LEAD_FROM_EMAIL on a domain verified in Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Supabase (project on the hamzabuildsweb account)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Random secret; its SHA-256 is stored in private.app_config ('server_secret_sha256').
SUPABASE_SERVER_SECRET=
